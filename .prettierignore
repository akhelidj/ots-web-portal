# Prettier ignore — see .prettierrc.json for the formatting rules.

# ── Dependencies ────────────────────────────────────────────────
# (Prettier ignores node_modules by default; listed here for clarity.)
node_modules/

# ── Build output ────────────────────────────────────────────────
/dist
/tmp

# ── Tooling / test caches ───────────────────────────────────────
/coverage
/.nx/cache
/.nx/workspace-data
.angular

# ── Generated / committed artifacts (do not reformat) ───────────
# Committed knowledge graph produced by Graphify — generated output.
graphify-out/

# Lockfile — generated and large; never hand-formatted.
package-lock.json

# Prisma migrations are generated SQL — leave them byte-for-byte as emitted.
api/prisma/migrations/

# Angular component templates — Prettier's html/angular parsers cannot parse
# Angular class-binding names that contain a Tailwind slash modifier, e.g.
# [class.bg-black/40]="...". These throw a hard SyntaxError (parser error, not
# a formatting diff), which would make `format:check` unusable as a gate.
# Left to Angular tooling; TS/SCSS/JSON and plain index.html are still covered.
portal/src/app/**/*.html
