{
  "name": "portal",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "portal/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/portal",
        "browser": "portal/src/main.ts",
        "tsConfig": "portal/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "serviceWorker": "portal/ngsw-config.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "portal/public"
          },
          "portal/src/manifest.webmanifest"
        ],
        "styles": ["portal/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "750kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "portal/src/environments/environment.ts",
              "with": "portal/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "dependsOn": ["sync-version"]
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "portal:build:production"
        },
        "development": {
          "buildTarget": "portal:build:development"
        }
      },
      "defaultConfiguration": "development",
      "dependsOn": ["sync-version"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.base.json"],
      "options": {
        "commands": [
          "tsc -p portal/tsconfig.app.json --noEmit",
          "tsc -p portal/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/portal"],
      "options": {
        "jestConfig": "portal/jest.config.ts",
        "passWithNoTests": true
      },
      "dependsOn": ["sync-version"]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "portal:build",
        "staticFilePath": "dist/portal/browser",
        "spa": true
      }
    },
    "sync-version": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/sync-portal-version.mjs"
      }
    }
  }
}
