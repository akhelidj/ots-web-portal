DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

JWT_ACCESS_SECRET="your-secret-key"
JWT_ACCESS_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=7
CORS_ALLOWED_ORIGINS="http://localhost:4200"

# --- Object storage (S3 migration) ---
# Selects the storage backend for BOTH attachment binaries (phase 1) and template
# workbooks (phase 2). Omit or set `local` (the default) to keep on-disk storage
# under api/uploads/ (attachments/ + templates/) — nothing else is needed.
STORAGE_DRIVER=local
# The keys below are ONLY read when STORAGE_DRIVER=s3. Fill them in your own
# api/.env (which is gitignored) — never commit real credentials.
# S3_BUCKET="your-bucket-name"          # required for s3
# S3_REGION="us-east-1"                 # required for s3 (falls back to AWS_REGION)
# S3_PREFIX="attachments/"              # optional attachment key prefix
# S3_TEMPLATE_PREFIX="templates/"       # optional template key prefix (default: templates/)
# AWS_ACCESS_KEY_ID="..."              # AWS credentials — resolved by the SDK's
# AWS_SECRET_ACCESS_KEY="..."          # default provider chain (or an instance role)
