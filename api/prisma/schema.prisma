generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                String             @id @default(uuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         AuditLog[]
  ChildReport       ChildReport[]
  customers         Customer[]
  inspectionReports InspectionReport[]
  SerialNumber      SerialNumber[]
  users             User[]
  approvalBatches   InspectionApprovalBatch[]
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  rotatedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ip                String?
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id                 String         @id @default(uuid())
  email              String
  name               String?
  role               UserRole
  tenantId           String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  passwordHash       String
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(true)
  customerId         String?
  refreshTokens      RefreshToken[]
  customer           Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  submittedBatches   InspectionApprovalBatch[] @relation("SubmittedBatches")
  reviewedBatches    InspectionApprovalBatch[] @relation("ReviewedBatches")
  signature          UserSignature?

  @@unique([tenantId, email])
}

// A user's ONE handwritten signature — a system datum on the account, consumed only at
// export. Replacing it never overwrites the stored object: each upload writes a NEW
// immutable object under a fresh key and re-points `storageKey` here, so a ReportSignature
// that froze an older key keeps resolving to the exact bytes that were in force. Old
// objects are therefore never deleted. Cascade on user delete removes only this pointer.
model UserSignature {
  id         String   @id @default(uuid())
  userId     String   @unique
  tenantId   String
  storageKey String
  mimeType   String   @default("image/png")
  // sha256 of the stored PNG bytes — integrity check on read and the dedupe key.
  hash       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// The signature FROZEN onto a report when its signer signed off (inspector: the
// IN_INSPECTION -> PENDING_APPROVAL transition). A pointer to the immutable object that was
// the signer's current signature at that instant — no bytes are copied. `slot` names what
// was signed: the template role (`inspectorSignature`), and later a signature-typed field
// key. Append-only: a re-submission after rework adds a row; export reads the latest per
// slot (via the revision snapshot, else live). `signedById` has no FK, like the transition
// logs, so deleting a user never blocks on or erases the audit trail.
model ReportSignature {
  id                 String           @id @default(uuid())
  tenantId           String
  inspectionReportId String
  slot               String
  signedById         String
  storageKey         String
  hash               String
  signedAt           DateTime         @default(now())
  // The report's `revisionNumber` when this pointer was written. Per-field signatures
  // (`field:<key>` slots) are only valid for the revision they were made on: a reopen bumps
  // the report's revision, which clears them without deleting history, and an old revision's
  // export keeps resolving the signature it was signed with. 0 for the inspector slot's
  // pre-existing rows (that slot never reads it).
  revisionNumber     Int              @default(0)
  inspectionReport   InspectionReport @relation(fields: [inspectionReportId], references: [id])

  @@index([tenantId, inspectionReportId, slot])
}

model Customer {
  id                 String             @id @default(uuid())
  name               String
  tenantId           String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  addressLine1       String?
  addressLine2       String?
  city               String?
  code               String?
  country            String?
  deactivatedAt      DateTime?
  deactivatedBy      String?
  deactivationReason String?
  email              String?
  isActive           Boolean            @default(true)
  phone              String?
  /// Optional brand colour (`#rrggbb`) that re-themes the customer's portal.
  brandColor         String?
  /// Storage key of the optional logo (see AttachmentStorage.buildLogoKey).
  logoKey            String?
  logoMimeType       String?
  version            Int                @default(1)
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  inspectionReports  InspectionReport[]
  users              User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TemplateVersion {
  id                String             @id @default(uuid())
  templateKey       String
  templateVersion   String
  mappingJson       Json
  fileRef           String?
  status            String
  hash              String?
  createdAt         DateTime           @default(now())
  inspectionReports InspectionReport[]

  @@unique([templateKey, templateVersion])
}

model Template {
  id              String         @id @default(uuid())
  tenantId        String
  templateKey     String
  templateVersion Int
  status          TemplateStatus
  fileKey         String
  hash            String
  changeNote      String
  definitionJson  Json?
  createdAt       DateTime       @default(now())
  createdById     String

  // Admin validation gate. A SUPERVISOR upload lands PENDING_APPROVAL; an ADMIN upload is
  // born APPROVED (an admin validating their own upload is a no-op ceremony). Only an
  // APPROVED row can be consumed — `getAvailableTemplates` ANDs this with ACTIVE +
  // defined, so a pending or rejected template can never back a report. Orthogonal to
  // `status` (lifecycle) and to `definitionJson` (form shape): a supervisor uploads AND
  // defines freely while pending; approval releases the finished thing for use.
  // The default is APPROVED so pre-existing rows (all admin-uploaded) stay usable.
  approvalStatus  TemplateApprovalStatus @default(APPROVED)
  approvedById    String?
  approvedAt      DateTime?
  // Required on reject, and surfaced to the supervisor on the templates list so a
  // rejection is actionable. Retry is a NEW version upload, never an in-place edit.
  rejectionReason String?

  definitionRevisions TemplateDefinitionRevision[]

  @@unique([tenantId, templateKey, templateVersion])
  @@index([tenantId, templateKey])
}

// Phase D — durable history for definitionJson edits. Every `PUT
// /templates/:id/definition` write (define or restore) appends a row capturing the
// PRIOR definition (the state being replaced) inside the same transaction as the
// overwrite, so an edit can never silently destroy the previous definition (the clobber
// gap). `Template.definitionJson` stays the authoritative CURRENT — nothing on the read
// path reads this table; it is write-and-restore only. Mirrors InspectionReportRevision
// (revisionNumber + immutable JSON blob + revisedBy/reason + @@unique[parent, number]).
//
// The very first define (prior definitionJson is NULL) records NO revision — there is no
// prior state to lose — so `definitionJson` here is always a real, non-null prior.
model TemplateDefinitionRevision {
  id             String   @id @default(uuid())
  templateId     String
  revisionNumber Int
  // The PRIOR definition this revision preserves (the one the edit replaced).
  definitionJson Json
  // Stable signature (sha256) of this prior definition's referenced-token set, and
  // whether the edit that replaced it CHANGED that token set (structural) vs left it
  // intact (cosmetic — label/type/scope tweak). Metadata only; never a gate.
  tokenSetHash   String
  tokensChanged  Boolean
  revisedById    String
  revisedAt      DateTime @default(now())
  revisionReason String?
  tenantId       String
  template       Template @relation(fields: [templateId], references: [id])

  @@unique([templateId, revisionNumber])
  @@index([tenantId, templateId])
}

model InspectionReport {
  id                    String                          @id @default(uuid())
  poNumber              String
  reportNumber          String?
  revisionNumber        Int                             @default(0)
  status                InspectionReportStatus          @default(DRAFT)
  tenantId              String
  customerId            String?
  templateVersionId     String?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  templateHash          String
  templateKey           String
  templateVersion       Int
  version               Int                             @default(1)
  // Phase D step 3 — the sole header store: generic, definition-keyed header values
  // (fieldKey -> value) written by the generic header edit form. `snapshot.header` is
  // assembled from metadata + this map alone; the legacy per-named-column axis
  // (grade/range/weight/nomWT/nomOD/nomID/connection/inspectionAddress/standardUsed/
  // inspectorComment/equipmentUsed/inspectionMethod) and its back-compat bridge were
  // retired here (no dev rows carried column values — the backfill was a no-op).
  headerData            Json?
  // Free-entry statistics typed by the inspector: [{ id, label, value, serials[] }].
  // Serials are referenced by their serial text (stable across offline remaps).
  statistics            Json?
  attachments           Attachment[]
  auditLogs             AuditLog[]
  childReports          ChildReport[]
  customer              Customer?                       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  legacyTemplateVersion TemplateVersion?                @relation(fields: [templateVersionId], references: [id])
  tenant                Tenant                          @relation(fields: [tenantId], references: [id])
  revisions             InspectionReportRevision[]
  transitionLogs        InspectionReportTransitionLog[]
  serialNumbers         SerialNumber[]
  approvalBatches       InspectionApprovalBatch[]
  signatures            ReportSignature[]
}

model SerialNumber {
  id                       String                    @id @default(uuid())
  serial                   String
  inspectionData           Json?
  disposition              SerialDisposition?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  approvalStatus           SerialApprovalStatus      @default(NOT_INSPECTED)
  inspectionReportId       String
  version                  Int                       @default(1)
  tenantId                 String
  childReportSerialNumbers ChildReportSerialNumber[]
  approvalBatchMemberships InspectionApprovalBatchSerialNumber[]
  inspectionReport         InspectionReport          @relation(fields: [inspectionReportId], references: [id])
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, inspectionReportId, serial])
  @@index([tenantId, inspectionReportId])
}

model ChildReport {
  id                 String                     @id @default(uuid())
  reportNumber       String?
  status             ChildReportStatus          @default(DRAFT)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  inspectionReportId String
  revisionNumber     Int                        @default(0)
  notes              String?
  tenantId           String
  type               ChildReportType            @default(REWORK)
  version            Int                        @default(1)
  inspectionReport   InspectionReport           @relation(fields: [inspectionReportId], references: [id])
  tenant             Tenant                     @relation(fields: [tenantId], references: [id])
  revisions          ChildReportRevision[]
  serialNumbers      ChildReportSerialNumber[]
  transitionLogs     ChildReportTransitionLog[]
  approvalBatches    InspectionApprovalBatch[]

  @@unique([tenantId, inspectionReportId, type], name: "unique_child_report_by_type")
  @@index([tenantId])
}

model ChildReportSerialNumber {
  id             String       @id @default(uuid())
  childReportId  String
  serialNumberId String
  inspectionData Json?
  disposition    SerialDisposition?
  approvalStatus SerialApprovalStatus @default(NOT_INSPECTED)
  childReport    ChildReport  @relation(fields: [childReportId], references: [id])
  serialNumber   SerialNumber @relation(fields: [serialNumberId], references: [id])

  @@unique([childReportId, serialNumberId])
}

model Attachment {
  id                 String           @id @default(uuid())
  filename           String
  url                String
  inspectionReportId String
  createdAt          DateTime         @default(now())
  inspectionReport   InspectionReport @relation(fields: [inspectionReportId], references: [id])
}

model InspectionReportTransitionLog {
  id                   String                  @id @default(uuid())
  fromStatus           InspectionReportStatus
  toStatus             InspectionReportStatus
  previousActiveStatus InspectionReportStatus?
  timestamp            DateTime                @default(now())
  inspectionReportId   String
  userId               String?
  inspectionReport     InspectionReport        @relation(fields: [inspectionReportId], references: [id])
}

model ChildReportTransitionLog {
  id            String            @id @default(uuid())
  fromStatus    ChildReportStatus
  toStatus      ChildReportStatus
  timestamp     DateTime          @default(now())
  childReportId String
  userId        String?
  childReport   ChildReport       @relation(fields: [childReportId], references: [id])
}

model AuditLog {
  id                 String            @id @default(uuid())
  action             String
  entity             String
  entityId           String
  reason             String?
  timestamp          DateTime          @default(now())
  tenantId           String
  userId             String?
  inspectionReportId String?
  inspectionReport   InspectionReport? @relation(fields: [inspectionReportId], references: [id])
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
}

model InspectionReportRevision {
  id                 String           @id @default(uuid())
  revisionNumber     Int
  snapshotJson       Json
  inspectionReportId String
  revisedAt          DateTime         @default(now())
  revisedById        String
  revisionReason     String
  tenantId           String
  inspectionReport   InspectionReport @relation(fields: [inspectionReportId], references: [id])

  @@unique([inspectionReportId, revisionNumber])
  @@index([tenantId, inspectionReportId])
}

model ChildReportRevision {
  id             String      @id @default(uuid())
  revisionNumber Int
  snapshotJson   Json
  childReportId  String
  revisedAt      DateTime    @default(now())
  revisedById    String
  revisionReason String
  tenantId       String
  childReport    ChildReport @relation(fields: [childReportId], references: [id])

  @@unique([childReportId, revisionNumber])
  @@index([tenantId, childReportId])
}

model InspectionApprovalBatch {
  id                 String                     @id @default(uuid())
  tenantId           String
  inspectionReportId String
  submittedByUserId  String
  submittedAt        DateTime                   @default(now())
  childReportId      String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  status             InspectionApprovalBatchStatus
  notes              String?
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  tenant             Tenant                     @relation(fields: [tenantId], references: [id])
  inspectionReport   InspectionReport           @relation(fields: [inspectionReportId], references: [id])
  submittedByUser    User                       @relation("SubmittedBatches", fields: [submittedByUserId], references: [id])
  reviewedByUser     User?                      @relation("ReviewedBatches", fields: [reviewedByUserId], references: [id])
  serialNumbers      InspectionApprovalBatchSerialNumber[]
  childReport        ChildReport?               @relation(fields: [childReportId], references: [id])

  @@index([tenantId, inspectionReportId])
  @@index([tenantId, status])
}

model InspectionApprovalBatchSerialNumber {
  id                        String                  @id @default(uuid())
  tenantId                  String
  inspectionApprovalBatchId String
  serialNumberId            String
  status                    String?                 // PENDING, APPROVED, or RETURNED
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  batch                     InspectionApprovalBatch @relation(fields: [inspectionApprovalBatchId], references: [id])
  serialNumber              SerialNumber            @relation(fields: [serialNumberId], references: [id])

  @@unique([tenantId, inspectionApprovalBatchId, serialNumberId])
  @@index([inspectionApprovalBatchId])
  @@index([serialNumberId])
}

enum UserRole {
  ADMIN
  RECEIVER
  INSPECTOR
  SUPERVISOR
  CUSTOMER
}

enum InspectionReportStatus {
  DRAFT
  RECEIVED
  READY_FOR_CLEANING
  READY_FOR_INSPECTION
  IN_INSPECTION
  PENDING_APPROVAL
  APPROVED
  ON_HOLD
  CLOSED
}

enum ChildReportStatus {
  DRAFT
  IN_INSPECTION
  PENDING_APPROVAL
  APPROVED
  CLOSED
}

enum SerialDisposition {
  PASS
  REWORK
  SCRAP
  HOLD
}

enum ChildReportType {
  REWORK
  SCRAP
  HOLD
}

enum TemplateStatus {
  ACTIVE
  DEPRECATED
}

// The admin validation gate on a template version (see Template.approvalStatus).
// PENDING_APPROVAL and REJECTED are both unusable for reports; only APPROVED is.
enum TemplateApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SerialApprovalStatus {
  NOT_INSPECTED
  INSPECTED_DRAFT
  SUBMITTED_FOR_APPROVAL
  APPROVED
}

enum InspectionApprovalBatchStatus {
  SUBMITTED
  APPROVED
  RETURNED
}
