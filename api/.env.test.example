# Integration-test database URL — TEMPLATE.
#
# Copy this file to `api/.env.test` (which is gitignored) to run the API
# integration tests. The tests read ONLY this file, never `api/.env`, so they can
# never inherit the app's real DATABASE_URL. If TEST_DATABASE_URL is missing the
# tests hard-fail instead of falling back to any other database.
#
# The URL must point at the dedicated, disposable test Postgres from
# docker-compose.test.yml (host port 5433, database `ots_test`). As a safety net,
# the test bootstrap also refuses any database whose name does not end in `_test`.

TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ots_test?schema=public"
