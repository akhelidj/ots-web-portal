{
  "name": "@ots/source",
  "version": "2.0.2",
  "license": "MIT",
  "scripts": {
    "sync:portal-version": "node scripts/sync-portal-version.mjs",
    "start:api": "nx serve api",
    "start:portal": "npm run sync:portal-version && nx serve portal",
    "build:api": "nx build api",
    "build:portal": "npm run sync:portal-version && nx build portal --configuration=production",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:api": "nx test api",
    "test:portal": "nx test portal",
    "test:api:integration": "nx run api:test-integration",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "nx graph",
    "db:reset": "npx dotenv -e api/.env -- npx prisma db push --force-reset --schema api/prisma/schema.prisma",
    "db:migrate": "npx dotenv -e api/.env -- npx prisma migrate dev --schema api/prisma/schema.prisma",
    "db:studio": "npx dotenv -e api/.env -- npx prisma studio --schema api/prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema api/prisma/schema.prisma",
    "db:seed": "npx -y tsx api/scripts/seed.ts",
    "db:seed:build": "npx esbuild api/scripts/seed.ts --bundle --platform=node --packages=external --outfile=dist/api/scripts/seed.js",
    "db:seed:run": "node dist/api/scripts/seed.js",
    "build:deploy": "npm run db:seed:build && nx build api",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "21.2.26",
    "@angular-devkit/schematics": "21.2.26",
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@angular/language-service": "21.2.25",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@nx/angular": "22.7.12",
    "@nx/eslint": "22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/jest": "22.7.12",
    "@nx/js": "22.7.12",
    "@nx/nest": "22.7.12",
    "@nx/node": "22.7.12",
    "@nx/web": "22.7.12",
    "@nx/webpack": "22.7.12",
    "@nx/workspace": "22.7.12",
    "@schematics/angular": "21.2.26",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "^1.15.47",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/utils": "^8.71.1",
    "angular-eslint": "21.4.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.0",
    "fake-indexeddb": "6.2.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "17.0.2",
    "lint-staged": "16.4.0",
    "nx": "22.7.12",
    "postcss": "^8.4.5",
    "prettier": "3.9.9",
    "prisma": "5.22.0",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^3.0.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "21.2.26",
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/service-worker": "21.2.25",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "5.22.0",
    "@types/jszip": "^3.4.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.6",
    "jszip": "^3.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "signature_pad": "^5.1.4",
    "xlsx": "^0.18.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-push": "npx nx affected -t typecheck lint test --base=origin/master",
    "preserveUnused": [
      "post-commit",
      "post-checkout"
    ]
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,html,scss,css,json,md,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  }
}
