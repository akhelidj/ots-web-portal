{
  "name": "@ots/source",
  "version": "1.0.1",
  "license": "MIT",
  "scripts": {
    "sync:portal-version": "node scripts/sync-portal-version.mjs",
    "start:api": "nx serve api",
    "start:portal": "npm run sync:portal-version && nx serve portal",
    "build:api": "nx build api",
    "build:portal": "npm run sync:portal-version && nx build portal --configuration=production",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:api": "nx test api",
    "test:portal": "nx test portal",
    "test:api:integration": "nx run api:test-integration",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "nx graph",
    "db:reset": "npx dotenv -e api/.env -- npx prisma db push --force-reset --schema api/prisma/schema.prisma",
    "db:migrate": "npx dotenv -e api/.env -- npx prisma migrate dev --schema api/prisma/schema.prisma",
    "db:studio": "npx dotenv -e api/.env -- npx prisma studio --schema api/prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema api/prisma/schema.prisma",
    "db:seed": "npx -y tsx api/scripts/seed.ts",
    "db:seed:build": "npx esbuild api/scripts/seed.ts --bundle --platform=node --packages=external --outfile=dist/api/scripts/seed.js",
    "db:seed:run": "node dist/api/scripts/seed.js",
    "build:deploy": "npm run db:seed:build && nx build api"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~21.1.0",
    "@angular-devkit/schematics": "~21.1.0",
    "@angular/build": "21.1.4",
    "@angular/cli": "21.1.4",
    "@angular/compiler-cli": "21.1.4",
    "@angular/language-service": "~21.1.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^22.5.1",
    "@nx/eslint": "^22.5.1",
    "@nx/eslint-plugin": "22.5.1",
    "@nx/jest": "^22.5.1",
    "@nx/js": "22.5.1",
    "@nx/nest": "^22.5.1",
    "@nx/node": "22.5.1",
    "@nx/web": "22.5.1",
    "@nx/webpack": "22.5.1",
    "@nx/workspace": "22.5.1",
    "@schematics/angular": "~21.1.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^21.0.1",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "fake-indexeddb": "6.2.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "nx": "22.5.1",
    "postcss": "^8.4.5",
    "prettier": "3.6.2",
    "prisma": "5.22.0",
    "tailwindcss": "^3.0.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "21.1.4",
    "@angular/animations": "21.1.4",
    "@angular/common": "21.1.4",
    "@angular/compiler": "21.1.4",
    "@angular/core": "21.1.4",
    "@angular/forms": "21.1.4",
    "@angular/platform-browser": "21.1.4",
    "@angular/platform-browser-dynamic": "21.1.4",
    "@angular/router": "21.1.4",
    "@angular/service-worker": "^21.1.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "5.22.0",
    "@types/jszip": "^3.4.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.5",
    "jszip": "^3.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0"
  }
}
